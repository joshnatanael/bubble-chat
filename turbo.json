{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_API_BASE",
    "NEXT_PUBLIC_REFRESH_TOKEN_EXPIRATION",
    "NEXT_PUBLIC_PARENT_DOMAIN",
    "PUSHER_APP_ID",
    "NEXT_PUBLIC_PUSHER_APP_KEY",
    "PUSHER_APP_SECRET"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
